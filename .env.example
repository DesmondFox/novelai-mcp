# NovelAI Persistent API Token.
# NovelAI -> Settings -> Account -> Persistent API Tokens
NOVELAI_API_KEY=your_novelai_persistent_api_token_here

# Where generated images are saved (optional, default: ~/Pictures/NovelAI)
# NOVELAI_OUTPUT_DIR=~/Pictures/NovelAI

# Default model of novelai_generate_image (optional, default: nai-diffusion-5-full)
# NOVELAI_DEFAULT_MODEL=nai-diffusion-5-full-medium
